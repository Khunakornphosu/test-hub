{
  "name": "@test-studio/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Logic ร่วมของ Test Studio: schema ของ step, แปลงเป็นโค้ด/คำอธิบาย, รันด้วย Playwright, self-healing, AI, ความปลอดภัย",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "default": "./dist/steps/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "default": "./dist/security/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.63.0",
    "vitest": "^5.0.0"
  }
}
