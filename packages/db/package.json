{
  "name": "@test-studio/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "\u0e0a\u0e31\u0e49\u0e19\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e02\u0e2d\u0e07 Test Studio: Postgres + Drizzle ORM (\u0e42\u0e1b\u0e23\u0e40\u0e08\u0e01\u0e15\u0e4c, \u0e40\u0e17\u0e2a\u0e40\u0e04\u0e2a, \u0e15\u0e31\u0e27\u0e41\u0e1b\u0e23\u0e25\u0e31\u0e1a, \u0e1b\u0e23\u0e30\u0e27\u0e31\u0e15\u0e34\u0e01\u0e32\u0e23\u0e23\u0e31\u0e19)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli-migrate.ts",
    "test": "vitest run",
    "import-poc": "tsx src/cli-import-poc.ts"
  },
  "dependencies": {
    "@test-studio/core": "*",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.0.0",
    "vitest": "^5.0.0"
  }
}
