# คัดลอกเป็น .env แล้วแก้ (ไฟล์ .env ไม่ถูกเก็บใน git)

# ฐานข้อมูล: ต้องเป็นฐานข้อมูลเดียวกับที่หน้าเว็บใช้ (docker compose up -d db ที่ root ของ repo)
DATABASE_URL=postgres://test_studio:test_studio@127.0.0.1:5433/test_studio
# key เข้ารหัสตัวแปรลับ ต้องเป็นค่าเดียวกับที่หน้าเว็บใช้ และห้ามเปลี่ยนหลังเริ่มใช้ (ไม่งั้นรหัสผ่านที่เก็บไว้ถอดไม่ได้)
SECRET_KEY=

# ----- การเข้าถึง -----
# ค่าเริ่มต้นฟังเฉพาะเครื่องตัวเอง (ไม่ต้องมี token) ถ้าเปิดให้เครื่องอื่นเข้า (HOST=0.0.0.0) ต้องตั้ง RUNNER_TOKEN_SECRET
# PORT=4800
# HOST=127.0.0.1
# พอร์ตของหน้าเว็บ: runner จะอนุญาตให้เบราว์เซอร์เปิดหน้า /demo-*.html ของหน้าเว็บที่พอร์ตนี้ (ค่าเริ่มต้น = PORT)
APP_PORT=4700
# secret ร่วมกับหน้าเว็บ: หน้าเว็บออก token อายุสั้นให้ผู้ใช้ที่ล็อกอินแล้ว runner ตรวจด้วยค่านี้
# RUNNER_TOKEN_SECRET=
# เว็บที่อนุญาตให้เชื่อม WebSocket (คั่นด้วย ,) ว่าง = ต้องเป็น origin เดียวกับ Host เท่านั้น
# ALLOWED_ORIGINS=https://test-studio.example.com
# จำนวนผู้ใช้ที่เปิดเบราว์เซอร์พร้อมกัน (แต่ละคนใช้ RAM ประมาณ 150-300 MB)
# MAX_SESSIONS=4
# สร้างตารางอัตโนมัติตอนเริ่ม
# RUN_MIGRATIONS=true

# ----- เว็บที่อนุญาตให้ทดสอบ (กัน SSRF) -----
# ค่าเริ่มต้น: เปิดได้ทุกเว็บสาธารณะ แต่ห้ามเครือข่ายภายใน/localhost/cloud metadata
# ระบุโดเมนที่อนุญาต (รวมเว็บภายในองค์กร) คั่นด้วย , และใช้ *. ได้ เมื่อตั้งแล้วจะเปิดได้เฉพาะโดเมนเหล่านี้
# ALLOWED_HOSTS=staging.example.com,*.internal.example.com
# ปิดการกันเครือข่ายภายในทั้งหมด (ใช้คนเดียวบนเครื่องตัวเอง)
# ALLOW_PRIVATE_NETWORK=true

# ----- AI (Gemini) -----
# GEMINI_API_KEY=
# GEMINI_MODEL=
