{
  "name": "@test-studio/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "บริการที่เปิด Chromium: screencast ให้หน้าเว็บ, บันทึก step จากการใช้งาน, รันเทส (WebSocket)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "dev:poc-host": "tsx dev/poc-host.ts",
    "test": "vitest run",
    "backup": "tsx src/backup-cli.ts"
  },
  "dependencies": {
    "@test-studio/core": "*",
    "@test-studio/db": "*",
    "playwright": "^1.63.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "express": "^5.1.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^5.0.0",
    "postgres": "^3.4.0"
  }
}
